# ────────────────────────────────────────────────────────────────
# Space Learn — environment template
# Copy to `.env` at the repo root and fill in real values.
# The web/ and api/ apps each read the vars they need from here.
# Never commit the real .env — it's gitignored.
# ────────────────────────────────────────────────────────────────

# ── Frontend (Vite exposes only VITE_* to the browser) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000/api/v1

# ── Backend: Supabase ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify JWTs locally without a network call to Supabase.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# ── Backend: Groq (LLM) ────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Google OAuth ───────────────────────────────────────────────
# No env vars here — configure Google provider inside Supabase
# Dashboard → Authentication → Providers → Google.

# ── Feature flags ──────────────────────────────────────────────
# true → stub (zero-vector) embeddings so RAG flow works without an
# embedding provider. Flip to false once real embeddings are wired.
USE_STUB_EMBEDDINGS=true

# ── Runtime ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
