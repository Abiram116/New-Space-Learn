# ────────────────────────────────────────────────────────────────
# Space Learn — environment template
# Copy to `.env` at the repo root and fill in real values.
# The web/ and api/ apps each read the vars they need from here.
# Never commit the real .env — it's gitignored.
# ────────────────────────────────────────────────────────────────

# ── Frontend (Vite exposes only VITE_* to the browser) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000/api/v1

# ── Backend: Supabase ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify JWTs locally without a network call to Supabase.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# ── Backend: Groq (LLM) ────────────────────────────────────────
# One key, three models: the API picks the model per request, so heavier work
# doesn't have to pay 70B latency and quota. Check console.groq.com/docs/models
# before changing these — Groq retires model ids periodically.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b       # RAG chat + quiz generation
GROQ_MODEL_FAST=llama-3.1-8b-instant # short, low-stakes prompts
GROQ_MODEL_VISION=qwen/qwen3.6-27b   # the image-capable model on this account
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=60

# ── Google OAuth ───────────────────────────────────────────────
# No env vars here — configure Google provider inside Supabase
# Dashboard → Authentication → Providers → Google.

# ── Embeddings ─────────────────────────────────────────────────
# Local, not hosted — BGE-small-en-v1.5, quantized ONNX, runs in-process.
# No API key, no external network dependency, $0 marginal cost. See
# docs/decisions.md for the investigation
# (measured memory/latency/quality) behind this choice, including why
# BGE-M3 was evaluated and rejected for production (~2.2GB model — several
# times Render free tier's entire 512MB ceiling) and kept only as an
# offline quality benchmark.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Feature flags ──────────────────────────────────────────────
# true → deterministic hash-based stub embeddings, so the RAG flow is
# exercisable with zero setup, no model download.
#
# IMPORTANT: under the stub, retrieval is NOT semantically meaningful — it
# returns chunks in an arbitrary-but-consistent order, not by relevance.
# Citations still point at a real page; that page just isn't necessarily the
# right one. To switch to real retrieval:
#   1. From the repo root: `npm run db:push` (Supabase CLI, pinned as a dev
#      dependency — see docs/operations/setup.md). Applies
#      supabase/migrations/20260810090000_embedding_dim_384.sql, which the
#      column needs FIRST — it's vector(1536) until then, and BGE-small
#      outputs 384 dims. Do not paste this into the dashboard SQL editor —
#      its tabs live in your browser only, a teammate can't see them, and the
#      CLI won't know the migration ran (see docs/operations/setup.md).
#   2. set USE_STUB_EMBEDDINGS=false
#   3. run `uv run python scripts/reembed_documents.py` from api/ — documents
#      ingested under the stub keep their meaningless vectors until you do
# The model itself needs no key and downloads once on first use (~130MB,
# cached on disk after).
USE_STUB_EMBEDDINGS=true

# ── API docs ───────────────────────────────────────────────────
# Serves /api/v1/docs and the OpenAPI schema. Fine locally; set false in
# production so the endpoint map isn't public.
EXPOSE_API_DOCS=true

# ── Runtime ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
