# ────────────────────────────────────────────────────────────────
# Space Learn — environment template
# Copy to `.env` at the repo root and fill in real values.
# The web/ and api/ apps each read the vars they need from here.
# Never commit the real .env — it's gitignored.
# ────────────────────────────────────────────────────────────────

# ── Frontend (Vite exposes only VITE_* to the browser) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000/api/v1

# ── Backend: Supabase ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify JWTs locally without a network call to Supabase.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# ── Backend: Groq (LLM) ────────────────────────────────────────
# One key, three models: the API picks the model per request, so heavier work
# doesn't have to pay 70B latency and quota. Check console.groq.com/docs/models
# before changing these — Groq retires model ids periodically.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # RAG chat + quiz generation
GROQ_MODEL_FAST=llama-3.1-8b-instant # short, low-stakes prompts
GROQ_MODEL_VISION=qwen/qwen3.6-27b   # the image-capable model on this account
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_S=60

# ── Google OAuth ───────────────────────────────────────────────
# No env vars here — configure Google provider inside Supabase
# Dashboard → Authentication → Providers → Google.

# ── Embeddings ─────────────────────────────────────────────────
# Groq hosts no embedding endpoint, so this is the one place the backend
# talks to a second provider. Any OpenAI-compatible /embeddings endpoint
# works — change EMBEDDING_BASE_URL to switch vendors without code changes.
# EMBEDDING_MODEL must output EXACTLY 1536 dimensions to match the pgvector
# column; a mismatch fails loudly at embed time rather than corrupting data.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ── Feature flags ──────────────────────────────────────────────
# true → deterministic hash-based stub embeddings, so the RAG flow is
# exercisable with no embedding provider account.
#
# IMPORTANT: under the stub, retrieval is NOT semantically meaningful —
# it returns chunks in an arbitrary-but-consistent order, not by relevance.
# Citations still point at a real page; that page just isn't necessarily the
# right one. To switch to real retrieval:
#   1. set EMBEDDING_API_KEY above
#   2. set USE_STUB_EMBEDDINGS=false
#   3. run `uv run python scripts/reembed_documents.py` from api/ — documents
#      ingested under the stub keep their meaningless vectors until you do
# Both 1 and 2 are required; setting the flag alone logs a warning and keeps
# using the stub rather than failing every upload.
USE_STUB_EMBEDDINGS=true

# ── API docs ───────────────────────────────────────────────────
# Serves /api/v1/docs and the OpenAPI schema. Fine locally; set false in
# production so the endpoint map isn't public.
EXPOSE_API_DOCS=true

# ── Runtime ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
